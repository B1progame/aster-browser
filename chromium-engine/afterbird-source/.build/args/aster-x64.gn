# Aster extension-engine proof build for the current x86_64 Android emulator.
# This keeps the upstream Chromium desktop-android extension subsystem and
# allows the emulator harness to load unpacked test extensions.
target_os = "android"
target_cpu = "x64"
is_desktop_android = true
is_debug = false
is_official_build = false
is_java_debug = true
symbol_level = 0
blink_symbol_level = 0
dcheck_always_on = false
chrome_public_manifest_package = "app.aster.browser"
android_override_version_code = "805000000"
android_override_version_name = "5.0.0"
treat_warnings_as_errors = false
disable_android_lint = true
android_static_analysis = "off"

# Meta/Facebook and Instagram Reels currently serve H.264/AAC MP4 streams.
# Chromium's default codec set omits these, so enable the same codec capability
# needed for common social video playback. Distribution is patent/licensing-sensitive.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

