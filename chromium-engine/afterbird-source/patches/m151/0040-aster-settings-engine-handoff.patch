+    /** Finds an unambiguous, live browser in the same Android task as Settings. */
+    private static org.chromium.chrome.browser.@Nullable ChromeTabbedActivity asterFindBrowser(
+            Activity settingsActivity) {
+        org.chromium.chrome.browser.@Nullable ChromeTabbedActivity found = null;
+        for (Activity candidate : org.chromium.base.ApplicationStatus.getRunningActivities()) {
+            if (!(candidate instanceof org.chromium.chrome.browser.ChromeTabbedActivity)
+                    || candidate.getTaskId() != settingsActivity.getTaskId()
+                    || candidate.isFinishing()
+                    || candidate.isDestroyed()) {
+                continue;
+            }
+            org.chromium.chrome.browser.ChromeTabbedActivity browser =
+                    (org.chromium.chrome.browser.ChromeTabbedActivity) candidate;
+            // Activity enumeration is unordered; never copy tabs from the wrong
+            // window if more than one browser matches this task.
+            if (found != null) return null;
+            found = browser;
+        }
+        return found;
+    }
+
+    /** Transfers only normal HTTP(S) tabs when the source is ready and non-private. */
+    private static void asterAttachRegularTabs(
+            Intent intent, org.chromium.chrome.browser.@Nullable ChromeTabbedActivity browser) {
+        if (browser == null || !browser.areTabModelsInitialized()) return;
+        org.chromium.chrome.browser.tabmodel.TabModelSelector selector =
+                browser.getTabModelSelector();
+        if (!selector.isTabStateInitialized() || selector.isOffTheRecordModelSelected()) return;
+        org.chromium.chrome.browser.tabmodel.TabModel model = selector.getModel(false);
+        java.util.ArrayList<String> urls = new java.util.ArrayList<>();
+        java.util.ArrayList<String> titles = new java.util.ArrayList<>();
+        int active = 0;
+        for (int i = 0; i < model.getCount(); i++) {
+            org.chromium.chrome.browser.tab.Tab tab = model.getTabAt(i);
+            if (tab == null || tab.getUrl() == null) continue;
+            String url = tab.getUrl().getSpec();
+            if (!url.startsWith("https://") && !url.startsWith("http://")) continue;
+            if (i == model.index()) active = urls.size();
+            urls.add(url);
+            titles.add(tab.getTitle() == null ? url : tab.getTitle().toString());
+        }
+        intent.putStringArrayListExtra("aster_tabs", urls);
+        intent.putStringArrayListExtra("aster_tab_titles", titles);
+        intent.putExtra("aster_active_tab", active);
+    }
+
