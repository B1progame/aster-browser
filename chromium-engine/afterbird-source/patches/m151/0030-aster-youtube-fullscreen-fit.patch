From: Aster Browser <aster@example.invalid>
Subject: [PATCH] Fit YouTube and Instagram fullscreen videos to the viewport

Apply video-fit rules only while YouTube or Instagram video is fullscreen.
Keep tablet desktop browsing enabled, default Instagram to its mobile layout,
and let users opt into desktop layout with the site menu.

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/app/ChromeActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/app/ChromeActivity.java
--- a/chrome/android/java/src/org/chromium/chrome/browser/app/ChromeActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/app/ChromeActivity.java
@@ -966,5 +966,41 @@ public abstract class ChromeActivity extends AsyncInitializationActivity
                     @Override
                     public void onPageLoadFinished(Tab tab, GURL url) {
                         postDeferredStartupIfNeeded();
                         OfflinePageUtils.showOfflineSnackbarIfNecessary(tab);
+                        String host = url == null ? "" : url.getHost();
+                        if ("m.youtube.com".equals(host) || "www.youtube.com".equals(host)) {
+                            WebContents webContents = tab.getWebContents();
+                            if (webContents != null) {
+                                webContents.evaluateJavaScript(
+                                        "(() => {"
+                                                + "if (document.getElementById('aster-youtube-video-fit')) return;"
+                                                + "const style = document.createElement('style');"
+                                                + "style.id = 'aster-youtube-video-fit';"
+                                                + "style.textContent = '#player-container-id:fullscreen video.html5-main-video,"
+                                                + " #movie_player:fullscreen video.html5-main-video {"
+                                                + "width:100vw!important;height:100dvh!important;"
+                                                + "left:0!important;top:0!important;object-fit:contain!important;}';"
+                                                + "(document.head || document.documentElement).appendChild(style);"
+                                                + "})();",
+                                        null);
+                            }
+                        }
+                        else if ("instagram.com".equals(host) || host.endsWith(".instagram.com")) {
+                            WebContents webContents = tab.getWebContents();
+                            if (webContents != null) {
+                                webContents.evaluateJavaScript(
+                                        "(() => {"
+                                                + "if (document.getElementById('aster-instagram-video-fit')) return;"
+                                                + "const style = document.createElement('style');"
+                                                + "style.id = 'aster-instagram-video-fit';"
+                                                + "style.textContent = 'video:fullscreen,video:-webkit-full-screen {"
+                                                + "width:100vw!important;height:100dvh!important;"
+                                                + "max-width:100vw!important;max-height:100dvh!important;"
+                                                + "left:0!important;top:0!important;object-fit:contain!important;"
+                                                + "background:#000!important;}';"
+                                                + "(document.head || document.documentElement).appendChild(style);"
+                                                + "})();",
+                                        null);
+                            }
+                        }
                     }
