+            selector.openNewTab(
+                    new org.chromium.content_public.browser.LoadUrlParams(url),
+                    org.chromium.chrome.browser.tab.TabLaunchType.FROM_EXTERNAL_APP,
+                    null,
+                    false);
+            existingUrls.add(url);
+        }
+        if (activeIndex >= 0 && activeIndex < urls.size()) {
+            String selectedUrl = urls.get(activeIndex);
+            for (int i = 0; i < model.getCount(); i++) {
+                org.chromium.chrome.browser.tab.Tab tab = model.getTabAt(i);
+                if (tab != null && tab.getUrl() != null
