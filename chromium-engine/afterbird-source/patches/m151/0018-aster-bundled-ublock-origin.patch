+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//build/config/android/rules.gni")
+
+# Extensions Aster ships inside the apk. Compression is disabled because
+# OpenApkAsset can only hand back assets that are stored uncompressed.
+android_assets("aster_bundled_extension_assets") {
+  disable_compression = true
+  renaming_sources = [ "ublock_origin.crx" ]
+  renaming_destinations = [ "aster/ublock_origin.crx" ]
+}
diff --git a/chrome/browser/resources/aster/README.md b/chrome/browser/resources/aster/README.md
new file mode 100644
index 0000000000..f6199e2f10
--- /dev/null
+++ b/chrome/browser/resources/aster/README.md
@@ -0,0 +1,17 @@
+# Bundled extensions
+
+`ublock_origin.crx` is deliberately **not** part of the patch series. It is a
+4MB signed binary from a third party, and carrying it as base64 inside a patch
+would make the series unreviewable and awkward to rebase.
+
+The bundled file is copied from this workspace asset:
+
+    chromium-engine/afterbird/third_party/ublock_origin/uBlockOrigin-1.73.0.crx
+
+Copy it here before building:
+
+    cp chromium-engine/afterbird/third_party/ublock_origin/uBlockOrigin-1.73.0.crx \
+       chrome/browser/resources/aster/ublock_origin.crx
+
+The source workspace records where the file came from, its checksum, and its
+licence. uBlock Origin is GPL-3.0 and is redistributed unmodified.
