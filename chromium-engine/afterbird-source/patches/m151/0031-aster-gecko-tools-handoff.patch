@@ -489,3 +489,45 @@
             torShortcut.setTranslationY(10f * mActivity.getResources().getDisplayMetrics().density);
             torShortcut.animate().alpha(1f).translationY(0f).setStartDelay(290).setDuration(340).start();
+
+            View toolsShortcut = mNewTabPageLayout.findViewById(R.id.aster_tools_shortcut);
+            toolsShortcut.setOnClickListener(
+                    view -> {
+                        android.content.Intent intent = mActivity.getPackageManager()
+                                .getLaunchIntentForPackage("app.aster.browser");
+                        if (intent == null) {
+                            android.widget.Toast.makeText(
+                                            mActivity,
+                                            "Install Aster GeckoView to open Aster tools",
+                                            android.widget.Toast.LENGTH_LONG)
+                                    .show();
+                            return;
+                        }
+                        org.chromium.chrome.browser.app.ChromeActivity activity =
+                                (org.chromium.chrome.browser.app.ChromeActivity) mActivity;
+                        org.chromium.chrome.browser.tabmodel.TabModel model =
+                                activity.getTabModelSelector().getModel(false);
+                        java.util.ArrayList<String> urls = new java.util.ArrayList<>();
+                        java.util.ArrayList<String> titles = new java.util.ArrayList<>();
+                        int active = 0;
+                        for (int i = 0; i < model.getCount(); i++) {
+                            org.chromium.chrome.browser.tab.Tab tab = model.getTabAt(i);
+                            if (tab == null || tab.getUrl() == null) continue;
+                            String url = tab.getUrl().getSpec();
+                            if (!url.startsWith("https://") && !url.startsWith("http://")) continue;
+                            if (i == model.index()) active = urls.size();
+                            urls.add(url);
+                            titles.add(tab.getTitle() == null ? url : tab.getTitle().toString());
+                        }
+                        intent.putStringArrayListExtra("aster_tabs", urls);
+                        intent.putStringArrayListExtra("aster_tab_titles", titles);
+                        intent.putExtra("aster_active_tab", active);
+                        intent.putExtra("aster_action", "tools");
+                        intent.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK
+                                | android.content.Intent.FLAG_ACTIVITY_CLEAR_TOP
+                                | android.content.Intent.FLAG_ACTIVITY_SINGLE_TOP);
+                        mActivity.startActivity(intent);
+                    });
+            toolsShortcut.setAlpha(0f);
+            toolsShortcut.setTranslationY(10f * mActivity.getResources().getDisplayMetrics().density);
+            toolsShortcut.animate().alpha(1f).translationY(0f).setStartDelay(360).setDuration(340).start();
         }
