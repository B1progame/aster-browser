<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="app.aster.chromium" />
        <package android:name="org.torproject.android" />
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:label="Aster Browser"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/aster_network_security_config"
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:taskAffinity="app.aster.shared"
        android:resizeableActivity="true">
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />
        <provider
            android:name=".AsterCrashInitProvider"
            android:authorities="${applicationId}.aster-crash-init"
            android:exported="false"
            android:initOrder="100" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <layout android:defaultWidth="1024dp" android:defaultHeight="640dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TorPrivateActivity"
            android:process=":torprivate"
            android:exported="false"
            android:launchMode="standard"
            android:taskAffinity="app.aster.shared"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:label="Aster Tor Private Window" />
        <activity
            android:name=".ChromiumFeaturesActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="app.aster.shared"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:label="Aster Chromium Tools" />
        <activity
            android:name=".ChromiumTorBridgeActivity"
            android:exported="false"
            android:launchMode="standard"
            android:taskAffinity="app.aster.shared"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:label="Connecting to Tor" />
        <activity
            android:name=".ChromiumTorActivity"
            android:process=":chromiumtorprivate"
            android:exported="false"
            android:launchMode="standard"
            android:taskAffinity="app.aster.shared"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:label="Aster Chromium Tor Window" />
    </application>
</manifest>
